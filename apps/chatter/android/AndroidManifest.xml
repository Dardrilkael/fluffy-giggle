<?xml version="1.0" encoding="utf-8"?>
<!-- Input to tools/package-android.ps1 (aapt2 link). The APK carries one
     Java class: ChatterActivity.java next to this file, a NativeActivity
     subclass that only holds a WifiManager.MulticastLock (Wi-Fi chips
     filter broadcast frames in hardware until an app holds the lock -
     without it the discovery beats never reach ws::net). Past the shim
     the OS dlopens lib/arm64-v8a/libchatter.so (android.app.lib_name
     below) and calls ANativeActivity_onCreate, which native_app_glue
     owns. INTERNET covers the sockets; the wifi/network permissions ride
     with the MulticastLock. Portrait-locked: the swapchain builds with
     preTransform = the surface's currentTransform, and a fixed
     orientation keeps that IDENTITY in the common case. extractNativeLibs
     keeps lib loading on the classic install-time extraction path (the
     packager deflates the .so; stored page-aligned .so's would need
     zipalign -p). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ws.chatter"
    android:versionCode="1"
    android:versionName="0.1">

    <!-- Chat needs the network: UDP discovery beats + TCP connections. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- MulticastLock: without it the chip-level filter drops the
         broadcast/multicast discovery beats before the kernel ever sees
         them. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- minSdk tracks ANDROID_PLATFORM (CMakePresets.json): libuv 1.53's
         unix spawn path calls posix_spawn, which bionic declares only
         from API 28. -->
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />

    <!-- hasCode="true": the APK carries classes.dex with the
         MulticastLock shim (apps without Java stay hasCode="false"). -->
    <application
        android:hasCode="true"
        android:label="ws chatter"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity
            android:name="com.ws.chatter.ChatterActivity"
            android:exported="true"
            android:label="ws chatter"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <!-- The module base name: libchatter.so, no prefix, no suffix. -->
            <meta-data android:name="android.app.lib_name"
                android:value="chatter" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
