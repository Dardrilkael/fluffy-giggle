{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/build/_fetchcontent"
      }
    },
    {
      "name": "_base-msvc",
      "hidden": true,
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Ninja, MSVC)",
      "inherits": "_base-msvc",
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "release",
      "displayName": "Release (Ninja, MSVC)",
      "inherits": "_base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vs-debug",
      "displayName": "Debug (Visual Studio generator)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/vs-debug",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/build/_fetchcontent"
      }
    },
    {
      "name": "vs-release",
      "displayName": "Release (Visual Studio generator)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/vs-release",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/build/_fetchcontent"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (Ninja, GCC, headless subset)",
      "inherits": "_base",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WS_BUILD_LIBS": "core;math;spice;jobs;settings;net;physics"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux + ASan/UBSan/_GLIBCXX_ASSERTIONS (inherits linux)",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -D_GLIBCXX_ASSERTIONS",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "spice-debug",
      "displayName": "Spice subset Debug (Ninja, MSVC, core;math;spice)",
      "inherits": "_base-msvc",
      "binaryDir": "${sourceDir}/build/spice-debug",
      "cacheVariables": {
        "WS_BUILD_LIBS": "core;math;spice"
      }
    },
    {
      "name": "spice-release",
      "displayName": "Spice subset Release (Ninja, MSVC, core;math;spice)",
      "inherits": "_base",
      "binaryDir": "${sourceDir}/build/spice-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WS_BUILD_LIBS": "core;math;spice"
      }
    },
    {
      "name": "android",
      "displayName": "Android (Ninja, NDK, arm64-v8a)",
      "inherits": "_base",
      "binaryDir": "${sourceDir}/build/android",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_static",
        "WS_BUILD_TESTS": "OFF",
        "WS_BUILD_APPS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "spice-debug", "configurePreset": "spice-debug" },
    { "name": "spice-release", "configurePreset": "spice-release" },
    { "name": "vs-debug", "configurePreset": "vs-debug", "configuration": "Debug" },
    { "name": "vs-release", "configurePreset": "vs-release", "configuration": "Release" },
    { "name": "android", "configurePreset": "android" }
  ],
  "testPresets": [
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "spice-debug",
      "configurePreset": "spice-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "spice-release",
      "configurePreset": "spice-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "vs-debug",
      "configurePreset": "vs-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "vs-release",
      "configurePreset": "vs-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
