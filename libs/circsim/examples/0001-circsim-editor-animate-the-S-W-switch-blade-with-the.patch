+        gnd.id = 11;
+        gnd.name = "0";
+        gnd.is_ground = true;
+        gnd.pins = {ws::circsim::PinRef{7, 3}};  // pin "c-"
+        nets.nets.push_back(ctl);
+        nets.nets.push_back(gnd);
+        nets.index();
+
+        s.directives = std::move(model_card);
+        p.id = 7;
+        p.symbol = "s";
