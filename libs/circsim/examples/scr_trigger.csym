{
    "format": "circsim-symbols",
    "version": 1,
    "symbols": [
        {
            "key": "bsource",
            "name": "Behavioral source",
            "spice": "B",
            "ref": "B",
            "pins": [
                {"name": "p", "pos": [-3, 0], "dir": 180},
                {"name": "n", "pos": [3, 0], "dir": 0}
            ],
            "value": false,
            "model": false,
            "emit": [
                {"param": "expr", "prefix": "", "optional": false}
            ],
            "params": [
                {"key": "expr", "type": "text", "label": "V=/I= expression", "default": "V=0"}
            ],
            "draw": [
                {"line": [[-3, 0], [-1, 0]]},
                {"circle": [0, 0, 1]},
                {"text": [0, 0, "B"]},
                {"line": [[1, 0], [3, 0]]}
            ]
        },
        {
            "key": "vswitch",
            "name": "Voltage switch",
            "spice": "S",
            "ref": "S",
            "pins": [
                {"name": "n+", "pos": [-3, 1], "dir": 180},
                {"name": "n-", "pos": [-3, -1], "dir": 180},
                {"name": "nc+", "pos": [3, 1], "dir": 0},
                {"name": "nc-", "pos": [3, -1], "dir": 0}
            ],
            "value": false,
            "model": true,
            "emit": [
                {"param": "model", "prefix": "", "optional": false}
            ],
            "params": [
                {"key": "model", "type": "text", "label": "Switch model", "default": "SW"}
            ],
            "draw": [
                {"line": [[-3, 1], [-0.5, 1]]},
                {"line": [[-0.5, 1], [0.5, -1]]},
                {"line": [[0.5, -1], [3, -1]]},
                {"line": [[-1.5, -1], [1.5, -1]]},
                {"line": [[1.5, -1], [1.5, -2]]},
                {"line": [[1.5, -2], [3, -2]]}
            ]
        },
        {
            "key": "subckt",
            "name": "Subcircuit instance",
            "spice": "X",
            "ref": "X",
            "pins": [
                {"name": "1", "pos": [-4, 1], "dir": 180},
                {"name": "2", "pos": [-4, -1], "dir": 180},
                {"name": "3", "pos": [4, 1], "dir": 0},
                {"name": "4", "pos": [4, -1], "dir": 0}
            ],
            "value": false,
            "model": true,
            "emit": [
                {"param": "model", "prefix": "", "optional": false}
            ],
            "params": [
                {"key": "model", "type": "text", "label": "Subcircuit", "default": ""}
            ],
            "draw": [
                {"line": [[-4, 1], [-2, 1]]},
                {"line": [[-4, -1], [-2, -1]]},
                {"line": [[2, 1], [4, 1]]},
                {"line": [[2, -1], [4, -1]]},
                {"rect": [-2, -2, 2, 2]},
                {"text": [0, 0, "X"]}
            ]
        }
    ]
}
